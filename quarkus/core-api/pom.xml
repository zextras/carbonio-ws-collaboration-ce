<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.zextras.carbonio.ws-collaboration.quarkus</groupId>
    <artifactId>ws-collaboration-quarkus-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>core-api</artifactId>

  <properties>
    <openapi.dir>${project.basedir}/../../carbonio-ws-collaboration-openapi/src/main/resources</openapi.dir>
  </properties>

  <dependencies>
    <dependency><groupId>jakarta.enterprise</groupId><artifactId>jakarta.enterprise.cdi-api</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>jakarta.ws.rs</groupId><artifactId>jakarta.ws.rs-api</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>
    <dependency><groupId>jakarta.validation</groupId><artifactId>jakarta.validation-api</artifactId></dependency>
    <dependency><groupId>jakarta.annotation</groupId><artifactId>jakarta.annotation-api</artifactId></dependency>
    <dependency><groupId>org.openapitools</groupId><artifactId>jackson-databind-nullable</artifactId></dependency>
    <dependency><groupId>io.swagger</groupId><artifactId>swagger-annotations</artifactId></dependency>
    <dependency><groupId>com.google.code.findbugs</groupId><artifactId>jsr305</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>async-models</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <configOptions>
                <useJakartaEe>true</useJakartaEe>
                <jsonTypeInfoPropertyName>type</jsonTypeInfoPropertyName>
                <jsonTypeInfoAs>EXISTING_PROPERTY</jsonTypeInfoAs>
              </configOptions>
              <generatorName>jaxrs-resteasy</generatorName>
              <engine>mustache</engine>
              <inputSpec>${openapi.dir}/asyncapi.yaml</inputSpec>
              <configurationFile>${openapi.dir}/async-generator-config.json</configurationFile>
              <templateDirectory>${openapi.dir}/templates</templateDirectory>
              <ignoreFileOverride>${openapi.dir}/generator-ignore</ignoreFileOverride>
              <output>${project.build.directory}/generated-sources/async</output>
              <skipValidateSpec>true</skipValidateSpec>
              <generateModels>true</generateModels>
              <generateApis>false</generateApis>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateModelTests>false</generateModelTests>
              <generateApiTests>false</generateApiTests>
              <generateModelDocumentation>false</generateModelDocumentation>
              <generateApiDocumentation>false</generateApiDocumentation>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-async-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${project.build.directory}/generated-sources/async/src/main/java</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
