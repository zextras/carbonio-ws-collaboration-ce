TZ=UTC
APP_ENVIRONMENT=docker
# Database connection
DATABASE_JDBC_DRIVER=org.postgresql.Driver
DATABASE_JDBC_URL="jdbc:postgresql://carbonio-postgres:5432/carbonio-ws-collaboration-ce-db"
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin
# RabbitMQ connection
EVENT_DISPATCHER_HOST=carbonio-message-broker
EVENT_DISPATCHER_PORT=10000
EVENT_DISPATCHER_USER_USERNAME=guest
EVENT_DISPATCHER_USER_PASSWORD=guest
# Consul connection
CONSUL_HOST=carbonio-consul-mock
CONSUL_PORT=8000
# MongooseIM connection
XMPP_SERVER_HOST=carbonio-message-dispatcher
XMPP_SERVER_HTTP_PORT=10000
XMPP_SERVER_USERNAME=admin
XMPP_SERVER_PASSWORD=admin-password

USER_MANAGEMENT_HOST=carbonio-user-management
USER_MANAGEMENT_PORT=10000

# other services
PREVIEWER_HOST=localhost
PREVIEWER_PORT=20002
VIDEO_SERVER_HOST=carbonio-videoserver
VIDEO_SERVER_PORT=8088
VIDEO_SERVER_TOKEN=api-secret
MAILBOX_NSLOOKUP_HOST=localhost
MAILBOX_NSLOOKUP_PORT=20008
STORAGES_HOST=localhost
STORAGES_PORT=20009