// Generated by carbonio-ws-collaboration-hcl from the packaged template on every
// upgrade and setup: local edits to this file are overwritten.
// To change the values, set them in /etc/zextras/service-discover/carbonio-ws-collaboration.env
// (KEY=value lines; "carbonio-ws-collaboration-hcl show" lists keys and defaults),
// then run carbonio-ws-collaboration-setup.

services {
  checks = [
    {
      http     = "http://127.78.0.4:10000/health/live"
      method   = "GET"
      timeout  = "{{ or (env "CHECK_TIMEOUT") "1s" }}"
      interval = "{{ or (env "CHECK_INTERVAL") "5s" }}"
    }
  ]

  connect {
    sidecar_service {
      proxy {
        local_service_address = "127.78.0.4"
        upstreams = [
          {
            destination_name   = "carbonio-storages"
            local_bind_address = "127.78.0.4"
            local_bind_port    = 20000
          },
          {
            destination_name   = "carbonio-user-management"
            local_bind_address = "127.78.0.4"
            local_bind_port    = 20001
          },
          {
            destination_name   = "carbonio-preview"
            local_bind_address = "127.78.0.4"
            local_bind_port    = 20002
          },
          {
            destination_name   = "carbonio-ws-collaboration-db"
            local_bind_address = "127.78.0.4"
            local_bind_port    = 20003
          },
          {
            destination_name   = "carbonio-message-dispatcher-http"
            local_bind_address = "127.78.0.4"
            local_bind_port    = 20004
          },
          {
            destination_name   = "carbonio-message-broker"
            local_bind_address = "127.78.0.4"
            local_bind_port    = 20005
          },
          {
            destination_name   = "carbonio-videoserver"
            local_bind_address = "127.78.0.4"
            local_bind_port    = 20006
          },
          {
            destination_name   = "carbonio-message-dispatcher-db"
            local_bind_address = "127.78.0.4"
            local_bind_port    = 20012
          }
        ]
      }
    }
  }

  name = "carbonio-ws-collaboration"
  port = 10000
}
