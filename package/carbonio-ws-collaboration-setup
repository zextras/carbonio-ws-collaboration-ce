# decrypt the bootstrap token, asking the password to the sys admin
# --setup check for SETUP_CONSUL_TOKEN env. variable and uses it
# to avoid re-asking for the password
if [[ $(id -u) -ne 0 ]]; then
  echo "Please run as root"
  exit 1
fi

# Decrypt the bootstrap token, asking the password to the sys admin
# --setup check for SETUP_CONSUL_TOKEN env. variable and uses it
# to avoid re-asking for the password
echo -n "Insert the cluster credential password: "
export CONSUL_HTTP_TOKEN
CONSUL_HTTP_TOKEN=$(service-discover bootstrap-token --setup)
EXIT_CODE="$?"
echo ""
if [[ "${EXIT_CODE}" != "0" ]]; then
  echo "Cannot access to bootstrap token"
  exit 1;
fi
# Limit secret visibility as much as possible
export -n SETUP_CONSUL_TOKEN

POLICY_NAME='carbonio-ws-collaboration-policy'
POLICY_DESCRIPTION='Carbonio Workstream Collaboration policy for service and sidecar proxy'

# Create or update policy for the specific service (this will be shared across cluster)
if ! consul acl policy create -name "${POLICY_NAME}" -description "${POLICY_DESCRIPTION}" -rules @/etc/carbonio/ws-collaboration/service-discover/policies.json >/dev/null 2>&1; then
    if ! consul acl policy update -no-merge -name "${POLICY_NAME}" -description "${POLICY_DESCRIPTION}" -rules @/etc/carbonio/ws-collaboration/service-discover/policies.json; then
      echo "Setup failed: Cannot update policy for ${POLICY_NAME}"
      exit 1
    fi
fi

trap 'echo Script for Workstream Collaboration terminated with error' EXIT
set -e
# Declare the service as http
consul config write /etc/carbonio/ws-collaboration/service-discover/service-protocol.json

# Allow other services to contact this service
consul config write /etc/carbonio/ws-collaboration/service-discover/intentions.json

# Create or reuse the deterministic token of this node (idempotent)
service-discover service-token ensure --service carbonio-ws-collaboration --policy "${POLICY_NAME}" \
  --token-file /etc/carbonio/ws-collaboration/service-discover/token --owner carbonio-ws-collaboration

# To pass the token to consul we need to inject it to a env. variable
# since it doesn't accept a file as an argument
mkdir -p /etc/systemd/system/carbonio-ws-collaboration.service.d/
cat >/etc/systemd/system/carbonio-ws-collaboration.service.d/override.conf <<EOF
[Service]
Environment="CONSUL_HTTP_TOKEN=$(cat /etc/carbonio/ws-collaboration/service-discover/token)"
EOF
chmod 0600 /etc/systemd/system/carbonio-ws-collaboration.service.d/override.conf
systemctl daemon-reload

# The service_id lives in Consul KV (like VideoServer) and is rendered into the
# service registration; it ends up in Consul Service.Meta, read at runtime via the agent API.
LOCAL_IP=$(hostname -I | tr -s ' ' '\n' | head -n 1)
export LOCAL_IP

SERVICE_ID_KEY="carbonio-ws-collaboration/meta/${LOCAL_IP}/service_id"
SERVICE_ID=$(consul kv get "${SERVICE_ID_KEY}" 2>/dev/null || true)

if [[ -z "${SERVICE_ID}" ]]; then
  SERVICE_ID=$(uuidgen)
  consul kv put "${SERVICE_ID_KEY}" "${SERVICE_ID}" >/dev/null
fi

consul-template \
  -template "/etc/zextras/service-discover/templates/carbonio-ws-collaboration-template.hcl:/etc/zextras/service-discover/carbonio-ws-collaboration.hcl" \
  -once
export -n LOCAL_IP

consul reload

carbonio-ws-collaboration-configs

# Sidecar first: the service reaches its database through it, also during a long migration at boot.
systemctl restart carbonio-ws-collaboration-sidecar.service
systemctl restart carbonio-ws-collaboration.service

# Remove the tokens leaked by previous setups (needs the bootstrap token)
service-discover service-token prune-legacy --service carbonio-ws-collaboration --policy "${POLICY_NAME}"

# Limit token visibility as much as possible
export -n CONSUL_HTTP_TOKEN
trap - EXIT
