# This script removes from consul the configuration values that are no longer used

CONSUL_TOKEN_PATH="/etc/carbonio/ws-collaboration/service-discover/token"

MAIN_SERVICE_NAME="carbonio-ws-collaboration"

OBSOLETE_CONFIGURATIONS=(
  "$MAIN_SERVICE_NAME/broker/connection-pool-size"
)

for KEY in "${OBSOLETE_CONFIGURATIONS[@]}"; do
  if consul kv get -token-file="$CONSUL_TOKEN_PATH" "$KEY" >/dev/null 2>&1; then
    consul kv delete -token-file="$CONSUL_TOKEN_PATH" "$KEY"
  fi
done
