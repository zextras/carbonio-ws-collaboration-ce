_package_common() {
  install -Dm755 "${srcdir}/carbonio-ws-collaboration-ce.jar" \
    "${pkgdir}/usr/share/carbonio/carbonio-ws-collaboration.jar"
  install -Dm755 "${srcdir}/carbonio-ws-collaboration-configs" \
    "${pkgdir}/usr/bin/carbonio-ws-collaboration-configs"
  install -Dm755 "${srcdir}/carbonio-ws-collaboration-configs-cleanup" \
    "${pkgdir}/usr/bin/carbonio-ws-collaboration-configs-cleanup"
  install -Dm755 "${srcdir}/carbonio-ws-collaboration-setup" \
    "${pkgdir}/usr/bin/carbonio-ws-collaboration-setup"
  install -Dm644 "${srcdir}/611-carbonio-ws-collaboration.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/611-carbonio-ws-collaboration.sh"
  install -Dm644 "${srcdir}/carbonio-ws-collaboration-template.hcl" \
    "${pkgdir}/etc/zextras/service-discover/templates/carbonio-ws-collaboration-template.hcl"
  install -Dm755 "${srcdir}/carbonio-ws-collaboration-hcl" \
    "${pkgdir}/usr/bin/carbonio-ws-collaboration-hcl"
  install -Dm644 "${srcdir}/carbonio-ws-collaboration.service" \
    "${pkgdir}/lib/systemd/system/carbonio-ws-collaboration.service"
  install -Dm644 "${srcdir}/logback.xml" \
    "${pkgdir}/etc/carbonio/ws-collaboration/logback.xml"
  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/ws-collaboration/service-discover/intentions.json"
  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/ws-collaboration/service-discover/policies.json"
  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/ws-collaboration/service-discover/service-protocol.json"
}

_package_systemd() {
  _package_common
  install -Dm644 "${srcdir}/carbonio-ws-collaboration-sidecar.service" \
    "${pkgdir}/lib/systemd/system/carbonio-ws-collaboration-sidecar.service"
}

_package_legacy() {
  _package_common
  install -Dm644 "${srcdir}/carbonio-ws-collaboration-sidecar-legacy.service" \
    "${pkgdir}/lib/systemd/system/carbonio-ws-collaboration-sidecar.service"
}

package() { _package_systemd; }
package__rocky_8() { _package_legacy; }
package__ubuntu_jammy() { _package_legacy; }

postinst() {
  getent group 'carbonio-ws-collaboration' >/dev/null ||
    groupadd -r 'carbonio-ws-collaboration'
  getent passwd 'carbonio-ws-collaboration' >/dev/null ||
    useradd -r -M -g 'carbonio-ws-collaboration' -s /sbin/nologin 'carbonio-ws-collaboration'

  mkdir -p /var/log/carbonio/ws-collaboration
  chown carbonio-ws-collaboration:carbonio-ws-collaboration /var/log/carbonio/ws-collaboration

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-ws-collaboration.service >/dev/null 2>&1 || :
    systemctl enable carbonio-ws-collaboration-sidecar.service >/dev/null 2>&1 || :
  fi

  if [ "$1" = "configure" ]; then
    carbonio-ws-collaboration-hcl migrate || :
    carbonio-ws-collaboration-hcl render || echo "WARNING: hcl render failed, run carbonio-ws-collaboration-setup"
  fi

  echo "========================================================="
  echo "Carbonio Workstream Collaboration installed successfully!"
  echo "You must run pending-setups to configure it correctly.   "
  echo "========================================================="
}

posttrans() {
  carbonio-ws-collaboration-hcl migrate || :
  carbonio-ws-collaboration-hcl render || echo "WARNING: hcl render failed, run carbonio-ws-collaboration-setup"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-ws-collaboration.service >/dev/null 2>&1 || :
    systemctl --no-reload disable carbonio-ws-collaboration-sidecar.service >/dev/null 2>&1 || :
    systemctl stop carbonio-ws-collaboration.service >/dev/null 2>&1 || :
    systemctl stop carbonio-ws-collaboration-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  rm -f /etc/carbonio/ws-collaboration/service-discover/token
  rm -f /etc/zextras/service-discover/carbonio-ws-collaboration.hcl
  if [ "$1" = "purge" ]; then
    rm -f /etc/zextras/service-discover/carbonio-ws-collaboration.env /etc/zextras/service-discover/carbonio-ws-collaboration.hcl.bak
  fi
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
